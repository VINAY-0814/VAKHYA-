# AI Studio Runtime & Optional Server-Side Gemini Enhancements
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# PostgreSQL (Sequelize ORM)
POSTGRES_USER=vakhya
POSTGRES_PASSWORD=vakhya_secret
POSTGRES_DB=vakhya_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://vakhya:vakhya_secret@localhost:5432/vakhya_db

# Redis (JWT Blacklist & OTP TTL Cache)
REDIS_URL=redis://localhost:6379

# Backend Server & JWT Auth
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-strong-32-char-secret
JWT_REFRESH_SECRET=replace-with-strong-32-char-refresh-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Python Translation Microservice
TRANSLATION_SERVICE_URL=http://localhost:8000
TRANSLATION_TCP_HOST=127.0.0.1
V2S_TCP_PORT=9001
S2V_TCP_PORT=9002

# Mediasoup SFU (Set MEDIASOUP_ANNOUNCED_IP to your LAN IP for physical Android testing)
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100

# SMTP (Optional for OTP Recovery Emails; falls back to dev console log if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vakhya.app

# Firebase Admin (Service account JSON string or path for FCM data-only call alerts)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Expo Android Mobile Client
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:4000/ws

# WebRTC TURN Relay (Required for strict firewalls / symmetric mobile NATs)
# Comma-separated STUN/TURN URLs, e.g. turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: Coturn static-auth-secret for automatic time-limited HMAC credentials
TURN_SHARED_SECRET=
